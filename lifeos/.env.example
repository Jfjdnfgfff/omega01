# LifeOS — متغيرات البيئة (انسخ هذا الملف إلى .env واملأه إن أردت تفعيل Firebase)
# ملاحظة: مفاتيح إعدادات Firebase العامة آمنة للواجهة الأمامية، لكن ممنوع وضع أي
# مفتاح إداري (service account) أو secret للـ Admin SDK هنا.
VITE_LIFEOS_FIREBASE_API_KEY=
VITE_LIFEOS_FIREBASE_AUTH_DOMAIN=
VITE_LIFEOS_FIREBASE_PROJECT_ID=
VITE_LIFEOS_FIREBASE_APP_ID=

# مفتاح AI Coach اختياري (مزوّد متوافق مع واجهة OpenAI). لا يُحفظ في قاعدة البيانات أبدًا.
VITE_LIFEOS_AI_BASE_URL=
VITE_LIFEOS_AI_MODEL=
