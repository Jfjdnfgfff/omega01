    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
